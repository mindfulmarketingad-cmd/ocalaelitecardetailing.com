{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "// build": "The generator writes plain HTML into the repository root, so the output directory is the root itself. Without outputDirectory, Vercel looks for public/ and fails the build.",
  "buildCommand": "node build.js && node tools/check-links.js",
  "outputDirectory": ".",
  "installCommand": "npm install --no-audit --no-fund",

  "cleanUrls": true,
  "trailingSlash": true,

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
